# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started.
#  Defaults work out of the box — just run: make up
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO

# Auth bypass — all requests auto-authenticated as Dev User (admin role)
AUTH_BYPASS=true

# ------------------------------------------------------------
# LLM (POLICY ENGINE / INSIGHTS)
# ------------------------------------------------------------
# Direct-Anthropic fallback used by services/llm_client.py while the real
# Auto integration (services/auto_client.py) remains a stretch goal — see
# that file's module docstring for why. Required for any natural_language
# policy evaluation or Insights LLM judgment to work.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5 if unset (see llm_client.py)
ANTHROPIC_MODEL=

# ------------------------------------------------------------
# SUPABASE (SYSTEM OF RECORD)
# ------------------------------------------------------------
# Read-only connection the Orchestrator poller (services/orchestrator_poller.py)
# uses to pick up new disruption/exception rows automatically — see
# services/system_of_record.py and core/supabase_db.py. Leave SUPABASE_DB_URL
# unset to run without this entirely: the poller no-ops (logs once, doesn't
# schedule anything) and the "Orders & Inventory Store" Data Manager row
# just stays "unconfigured", same as before this feature existed.
#
# Project Settings -> Database -> Connection string -> URI (the direct
# connection, not the pooler, unless you specifically want pooling).
SUPABASE_DB_URL=
# Table name to poll — must have at least `id` and `updated_at` columns.
SUPABASE_SOR_TABLE=disruptions
# entity_name passed to the Policy Engine for each polled row — your
# policies' entity_name should match this.
SUPABASE_SOR_ENTITY_NAME=disruption
# How often the poller checks for new rows, in seconds.
ORCHESTRATOR_POLL_INTERVAL_SECONDS=30

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:3001

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
NEXTAUTH_SECRET=

# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev
