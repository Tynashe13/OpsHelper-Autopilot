# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started.
#  Defaults work out of the box — just run: make up
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO

# Auth bypass — all requests auto-authenticated as Dev User (admin role)
AUTH_BYPASS=true

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# SUPERVITY AUTO — orchestration + LLM judgment
# ------------------------------------------------------------
# Custom API Key generated from Auto's Developer Settings
# (auto.supervity.ai -> Developer Settings -> API Keys)
AUTO_API_KEY=

# Your org key on Auto — sent as the x-active-org header on every request
AUTO_ORG_KEY=

# Workflow ID of the generic "LLM Judgment" workflow/Operator on Auto,
# used for policy evaluation (services/policy_engine.py's complete_json calls)
AUTO_LLM_JUDGMENT_WORKFLOW_ID=

# Workflow ID of the Ops Helper ORCHESTRATOR on Auto — the workflow that
# itself coordinates the 5+ Operators (Impact Finder, Recovery Finder,
# Recovery Planner, Human Approval Operator, Execute Human Choice, Auto
# Execute Plan, Check Outlook for Notices). Used only by the AI Manager
# chat surface (routers/ai_manager.py) — distinct from
# AUTO_LLM_JUDGMENT_WORKFLOW_ID above.
AUTO_ORCHESTRATOR_WORKFLOW_ID=

# Base URL for Auto's API — override only if pointed at a different env
AUTO_API_BASE_URL=https://auto.supervity.ai/api/v1

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:3001

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
NEXTAUTH_SECRET=

# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev
